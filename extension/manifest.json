{
  "manifest_version": 3,
  "name": "Nimbl Radar",
  "short_name": "Radar",
  "version": "1.1.0",
  "description": "Use Nimbl Radar on LinkedIn: see who is already in Radar, save people, insert drafts and log touches. You always press Send yourself.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nimbl Radar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://nimbl-radar-app.onrender.com/*",
    "https://radar.nimbl.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "icons/icon32.png"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ]
}